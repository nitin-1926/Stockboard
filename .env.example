# Neon pooled connection string (runtime queries)
DATABASE_URL=
# Neon direct (unpooled) connection string (migrations)
DATABASE_URL_UNPOOLED=
# Better Auth signing secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public base URL Better Auth runs on, e.g. http://localhost:3000
BETTER_AUTH_URL=
# Google OAuth web client ID
GOOGLE_CLIENT_ID=
# Google OAuth web client secret
GOOGLE_CLIENT_SECRET=
# Google account email that is always the owner
OWNER_EMAIL=
# 32-byte base64 key for encrypting broker credentials at rest
ENCRYPTION_KEY=
# Previous ENCRYPTION_KEY, decrypt-only, set only during a key rotation (docs/adr/0009)
ENCRYPTION_KEY_PREVIOUS=
# Bearer secret cron callers must send to /api/cron/*
CRON_SECRET=
# HMAC secret for signing share-link cookies
SHARE_LINK_SECRET=
# Public base URL of the app, e.g. http://localhost:3000
APP_URL=
